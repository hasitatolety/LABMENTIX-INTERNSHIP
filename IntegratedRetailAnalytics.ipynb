import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import IsolationForest
from xgboost import XGBRegressor
from sklearn.metrics import mean_squared_error, silhouette_score
import warnings

# Initial Configuration
warnings.filterwarnings('ignore')
sns.set(style="whitegrid")

# 1. DATA LOADING (Optimized for GitHub Repository)
print("Step 1: Loading local datasets...")
try:
    # Ensure filenames match your repository exactly
    features = pd.read_excel("Features data set.xlsx")
    sales = pd.read_excel("sales data-set.xlsx")
    stores = pd.read_excel("stores data-set.xlsx")
    print("✅ Local Excel files loaded successfully.")
except Exception as e:
    print(f"❌ Error: Could not find Excel files in the repo. {e}")

# 2. STANDARDIZING & MERGING
for dataframe in [features, sales, stores]:
    dataframe.columns = dataframe.columns.str.replace(' ', '_').str.title()
    dataframe.rename(columns={'Isholiday': 'IsHoliday', 'Cpi': 'CPI'}, inplace=True)

df = pd.merge(sales, features, on=['Store', 'Date'], how='left')
if 'IsHoliday_x' in df.columns:
    df['IsHoliday'] = df['IsHoliday_x']
    df.drop(['IsHoliday_x', 'IsHoliday_y'], axis=1, inplace=True)
df = pd.merge(df, stores, on='Store', how='left')

# 3. PREPROCESSING
df['Date'] = pd.to_datetime(df['Date'], dayfirst=True, errors='coerce')
df['CPI'] = df['CPI'].fillna(df['CPI'].median())
df['Unemployment'] = df['Unemployment'].fillna(df['Unemployment'].median())

# 4. ANOMALY DETECTION (Component 1)
print("Step 4: Running Anomaly Detection...")
target_col = 'Weekly_Sales'
iso = IsolationForest(contamination=0.01, random_state=42)
df['Anomaly'] = iso.fit_predict(df[[target_col]].fillna(0))
df_clean = df[df['Anomaly'] == 1].reset_index(drop=True)

# --- GRAPH 1: ANOMALY VISUALIZATION ---
plt.figure(figsize=(12, 5))
sns.scatterplot(data=df.sample(2000), x='Date', y=target_col, hue='Anomaly', palette={1: 'blue', -1: 'red'})
plt.title("Detected Sales Anomalies (Red Points)")
plt.show()

# 5. STORE SEGMENTATION (Component 2)
print("Step 5: Store Segmentation...")
store_stats = df_clean.groupby('Store').agg({target_col: 'mean', 'Size': 'first', 'Temperature': 'mean'}).reset_index()
scaler = StandardScaler()
scaled = scaler.fit_transform(store_stats.drop('Store', axis=1))
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
store_stats['Cluster'] = kmeans.fit_predict(scaled)

# --- GRAPH 2: CLUSTER VISUALIZATION ---
plt.figure(figsize=(10, 6))
sns.scatterplot(data=store_stats, x='Size', y=target_col, hue='Cluster', palette='viridis', s=100)
plt.title("Store Segments based on Size and Average Sales")
plt.show()

# 6. DEMAND FORECASTING (Component 3)
print("Step 6: Training Forecasting Model...")
df_final = pd.merge(df_clean, store_stats[['Store', 'Cluster']], on='Store', how='left')
if 'Type' in df_final.columns:
    df_final = pd.get_dummies(df_final, columns=['Type'])

df_final['Week'] = df_final['Date'].dt.isocalendar().week.astype(int)
df_final['Year'] = df_final['Date'].dt.year

features_list = ['Store', 'Dept', 'CPI', 'Unemployment', 'Fuel_Price', 'Size', 'Cluster', 'Week', 'Year']
features_list += [c for c in df_final.columns if 'Type_' in c]
X = df_final[features_list].fillna(0)
y = df_final[target_col]

split = int(len(X) * 0.8)
X_train, X_test, y_train, y_test = X[:split], X[split:], y[:split], y[split:]

model = XGBRegressor(n_estimators=100, learning_rate=0.1, max_depth=5, random_state=42)
model.fit(X_train, y_train)
y_pred = model.predict(X_test)

# --- GRAPH 3: FORECAST ACCURACY ---
plt.figure(figsize=(15, 6))
plt.plot(y_test.values[:100], label="Actual Sales", color="blue", alpha=0.6)
plt.plot(y_pred[:100], label="Predicted Sales", color="orange", linestyle="--")
plt.title("Demand Forecast: Actual vs Predicted (Last 100 Weeks)")
plt.legend()
plt.show()

# 7. FINAL OUTPUT
print("\n" + "="*45)
print(f"Clustering Quality (Silhouette): {silhouette_score(scaled, store_stats['Cluster']):.4f}")
print(f"Forecasting Accuracy (RMSE):     {np.sqrt(mean_squared_error(y_test, y_pred)):.2f}")
print("="*45)
