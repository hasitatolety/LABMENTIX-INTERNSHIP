# ==============================================================================
# RETAIL ANALYTICS: ANOMALY DETECTION, CLUSTERING & DEMAND FORECASTING
# ==============================================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
import os
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import IsolationForest, RandomForestRegressor
from sklearn.metrics import mean_squared_error, silhouette_score
from sklearn.model_selection import train_test_split

# --- SETUP ---
warnings.filterwarnings('ignore')
sns.set_theme(style="whitegrid", palette="magma")
plt.rcParams['figure.figsize'] = (12, 5)
plt.rcParams['figure.dpi'] = 100

# ------------------------------------------------------------------------------
# 1. SMART DATA LOADING (Excel & CSV Compatible)
# ------------------------------------------------------------------------------
def load_data():
    """Locates and loads the datasets from the current directory."""
    files = os.listdir('.')
    data = {'features': None, 'sales': None, 'stores': None}
    
    for key in data.keys():
        for f in files:
            if key in f.lower() and f.endswith(('.xlsx', '.xls', '.csv')):
                print(f"Detected {key} file: {f}")
                data[key] = pd.read_excel(f) if 'xls' in f else pd.read_csv(f)
                break
    return data['features'], data['sales'], data['stores']

features, sales, stores = load_data()

if features is None or sales is None or stores is None:
    print("Error: Missing input files in the repository directory.")
else:
    # --------------------------------------------------------------------------
    # 2. PREPROCESSING & MERGING
    # --------------------------------------------------------------------------
    for df_tmp in [features, sales, stores]:
        df_tmp.columns = df_tmp.columns.str.strip().str.replace(' ', '_').str.title()
        df_tmp.rename(columns={'Isholiday': 'IsHoliday', 'Cpi': 'CPI'}, inplace=True)

    df = pd.merge(sales, features, on=['Store', 'Date'], how='left')
    if 'IsHoliday_x' in df.columns:
        df['IsHoliday'] = df['IsHoliday_x']
        df.drop(['IsHoliday_x', 'IsHoliday_y'], axis=1, inplace=True)
    df = pd.merge(df, stores, on='Store', how='left')

    df['Date'] = pd.to_datetime(df['Date'], errors='coerce')
    df = df.dropna(subset=['Date', 'Weekly_Sales'])
    df['CPI'] = df['CPI'].fillna(df['CPI'].median())
    df['Unemployment'] = df['Unemployment'].fillna(df['Unemployment'].median())

    # --------------------------------------------------------------------------
    # 3. COMPONENT 1: ANOMALY DETECTION
    # --------------------------------------------------------------------------
    print("Initiating Anomaly Detection...")
    iso = IsolationForest(contamination=0.01, random_state=42)
    df['Anomaly_Flag'] = iso.fit_predict(df[['Weekly_Sales']])
    df_clean = df[df['Anomaly_Flag'] == 1].reset_index(drop=True)

    # --------------------------------------------------------------------------
    # 4. COMPONENT 2: STORE SEGMENTATION (Clustering)
    # --------------------------------------------------------------------------
    print("Initiating Store Segmentation...")
    store_stats = df_clean.groupby('Store').agg({'Weekly_Sales': 'mean', 'Size': 'first', 'Temperature': 'mean'}).reset_index()
    scaler = StandardScaler()
    scaled = scaler.fit_transform(store_stats.drop('Store', axis=1))
    kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
    store_stats['Cluster'] = kmeans.fit_predict(scaled)

    # --------------------------------------------------------------------------
    # 5. DATA VISUALIZATION (The "Output" for GitHub)
    # --------------------------------------------------------------------------
    print("Generating Visual Insights...")

    # Chart 1: Sales Distribution
    plt.figure()
    sns.histplot(df_clean['Weekly_Sales'], bins=50, kde=True, color='blue')
    plt.title('Chart 1: Distribution of Weekly Sales (Anomalies Removed)')
    plt.show()

    # Chart 2: Store Clustering Results
    plt.figure()
    sns.scatterplot(data=store_stats, x='Size', y='Weekly_Sales', hue='Cluster', palette='viridis', s=100)
    plt.title('Chart 2: Multivariate Store Segmentation (Size vs Sales)')
    plt.show()

    # Chart 3: Correlation Matrix
    plt.figure(figsize=(10, 7))
    sns.heatmap(df_clean[['Weekly_Sales', 'CPI', 'Unemployment', 'Fuel_Price', 'Temperature', 'Size']].corr(), annot=True, cmap='coolwarm')
    plt.title('Chart 3: Feature Correlation Heatmap')
    plt.show()

    # --------------------------------------------------------------------------
    # 6. COMPONENT 3: DEMAND FORECASTING
    # --------------------------------------------------------------------------
    print("Training Forecasting Model...")
    df_final = pd.merge(df_clean, store_stats[['Store', 'Cluster']], on='Store', how='left')
    df_final['Week'] = df_final['Date'].dt.isocalendar().week.astype(int)
    df_final['Year'] = df_final['Date'].dt.year
    
    feats = ['Store', 'Dept', 'CPI', 'Unemployment', 'Fuel_Price', 'Size', 'Cluster', 'Week', 'Year']
    X = df_final[feats].fillna(0)
    y = df_final['Weekly_Sales']
    
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, shuffle=False)
    
    model = RandomForestRegressor(n_estimators=50, max_depth=10, random_state=42, n_jobs=-1)
    model.fit(X_train, y_train)

    # --------------------------------------------------------------------------
    # 7. FINAL RESULTS SUMMARY
    # --------------------------------------------------------------------------
    preds = model.predict(X_test)
    rmse = np.sqrt(mean_squared_error(y_test, preds))
    
    print("\n" + "="*50)
    print("FINAL ANALYSIS COMPLETED")
    print("="*50)
    print(f"Clustering Quality (Silhouette): {silhouette_score(scaled, store_stats['Cluster']):.4f}")
    print(f"Forecasting Accuracy (RMSE):     ${rmse:.2f}")
    print("="*50)
    
    # Show Preview of Results
    results_preview = X_test.head(10).copy()
    results_preview['Actual'] = y_test.head(10).values
    results_preview['Predicted'] = preds[:10]
    display(results_preview[['Year', 'Week', 'Actual', 'Predicted']])
