# Project Name - Integrated Retail Analytics for Store Optimization
# =============================================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import IsolationForest
from xgboost import XGBRegressor
from sklearn.metrics import mean_squared_error, silhouette_score
import warnings

# Initial Configuration
warnings.filterwarnings('ignore')
sns.set_theme(style="whitegrid") # Sets a professional look for GitHub visuals

def load_data_robustly(url):
    """Utility function to fetch Google Sheets directly into a DataFrame."""
    try:
        sheet_id = url.split('/d/')[1].split('/')[0]
        csv_url = f'https://docs.google.com/spreadsheets/d/{sheet_id}/export?format=csv'
        df = pd.read_csv(csv_url)
        df.columns = df.columns.str.strip()
        return df
    except Exception as e:
        print(f"Error loading from {url}: {e}")
        return None

# 1. DATA LOADING
print("Step 1: Fetching datasets...")
features_url = "https://docs.google.com/spreadsheets/d/1UZY23n6Ef7ambSBW2Qlvcb9swDKHs0cwwouSz814wX4/edit"
sales_url = "https://docs.google.com/spreadsheets/d/1IQ3VZ4MW5UEsRe4jYoNlf1Bv6kJHltSVxm65FsHXC8g/edit"
stores_url = "https://docs.google.com/spreadsheets/d/1PPKc_ZibOBn6_ofSlMXOKBEvJ63uT-3slDFqsW5DBms/edit"

features = load_data_robustly(features_url)
sales = load_data_robustly(sales_url)
stores = load_data_robustly(stores_url)

if features is not None and sales is not None and stores is not None:
    print("All datasets loaded successfully.")

    # 2. STANDARDIZING & MERGING
    for dataframe in [features, sales, stores]:
        dataframe.columns = dataframe.columns.str.replace(' ', '_').str.title()
        dataframe.rename(columns={'Isholiday': 'IsHoliday', 'Cpi': 'CPI'}, inplace=True)

    df = pd.merge(sales, features, on=['Store', 'Date'], how='left')
    if 'IsHoliday_x' in df.columns:
        df['IsHoliday'] = df['IsHoliday_x']
        df.drop(['IsHoliday_x', 'IsHoliday_y'], axis=1, inplace=True)
    df = pd.merge(df, stores, on='Store', how='left')

    # 3. PREPROCESSING
    print("Step 2: Preprocessing...")
    df['Date'] = pd.to_datetime(df['Date'], dayfirst=True, errors='coerce')
    md_cols = ['Markdown1', 'Markdown2', 'Markdown3', 'Markdown4', 'Markdown5']
    for col in md_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0)
    
    df['CPI'] = df['CPI'].fillna(df['CPI'].median())
    df['Unemployment'] = df['Unemployment'].fillna(df['Unemployment'].median())
    target_col = 'Weekly_Sales'

    # 4. ANOMALY DETECTION
    print("Step 3: Detecting Sales Anomalies...")
    iso = IsolationForest(contamination=0.01, random_state=42)
    df['Anomaly_Score'] = iso.fit_predict(df[[target_col]].fillna(0))
    
    # Save Visualization 1: Anomalies
    plt.figure(figsize=(12, 5))
    sns.scatterplot(data=df, x='Date', y=target_col, hue='Anomaly_Score', palette={1: 'blue', -1: 'red'}, alpha=0.6)
    plt.title("Retail Sales Anomaly Detection (Red = Outliers)")
    plt.savefig('viz_anomalies.png')
    plt.close()

    df_clean = df[df['Anomaly_Score'] == 1].reset_index(drop=True)

    # 5. STORE SEGMENTATION
    print("Step 4: Clustering Stores...")
    store_stats = df_clean.groupby('Store').agg({target_col: 'mean', 'Size': 'first'}).reset_index()
    scaler = StandardScaler()
    scaled = scaler.fit_transform(store_stats.drop('Store', axis=1))
    kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
    store_stats['Cluster'] = kmeans.fit_predict(scaled)

    # Save Visualization 2: Clusters
    plt.figure(figsize=(10, 6))
    sns.scatterplot(data=store_stats, x='Size', y=target_col, hue='Cluster', palette='viridis', s=100)
    plt.title("Store Segmentation: Size vs Average Sales")
    plt.savefig('viz_clusters.png')
    plt.close()

    # 6. FORECASTING MODEL
    print("Step 5: Training XGBoost Model...")
    df_final = pd.merge(df_clean, store_stats[['Store', 'Cluster']], on='Store', how='left')
    if 'Type' in df_final.columns:
        df_final = pd.get_dummies(df_final, columns=['Type'])

    df_final['Week'] = df_final['Date'].dt.isocalendar().week.astype(int)
    df_final['Year'] = df_final['Date'].dt.year

    features_list = ['Store', 'Dept', 'CPI', 'Unemployment', 'Fuel_Price', 'Size', 'Cluster', 'Week', 'Year']
    features_list += [c for c in df_final.columns if 'Type_' in c]
    
    X = df_final[features_list].fillna(0)
    y = df_final[target_col]

    split = int(len(X) * 0.8)
    X_train, X_test, y_train, y_test = X[:split], X[split:], y[:split], y[split:]

    model = XGBRegressor(n_estimators=100, learning_rate=0.1, max_depth=5, random_state=42)
    model.fit(X_train, y_train)

    # Save Visualization 3: Feature Importance
    plt.figure(figsize=(10, 6))
    feat_imp = pd.Series(model.feature_importances_, index=features_list).sort_values(ascending=False)
    feat_imp.plot(kind='barh', color='teal')
    plt.title("Key Drivers of Retail Demand (Feature Importance)")
    plt.savefig('viz_importance.png')
    plt.close()

    # 7. FINAL OUTPUT
    print("\n" + "="*45)
    print("PIPELINE COMPLETE - 3 IMAGES GENERATED")
    print("="*45)
    print(f"Clustering Quality (Silhouette): {silhouette_score(scaled, store_stats['Cluster']):.4f}")
    print(f"Forecasting Accuracy (RMSE):     {np.sqrt(mean_squared_error(y_test, model.predict(X_test))):.2f}")
    print("="*45)
    print("Files saved: viz_anomalies.png, viz_clusters.png, viz_importance.png")
