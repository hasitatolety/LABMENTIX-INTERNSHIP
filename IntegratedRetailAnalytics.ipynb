# ==============================================================================
# INTEGRATED RETAIL ANALYTICS: ANOMALY DETECTION, CLUSTERING & FORECASTING
# ==============================================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import IsolationForest, RandomForestRegressor
from sklearn.metrics import mean_squared_error, silhouette_score
from sklearn.model_selection import train_test_split

# Setup
warnings.filterwarnings('ignore')
sns.set_theme(style="whitegrid", palette="viridis")

# ------------------------------------------------------------------------------
# 1. DATA LOADING (Local Files)
# ------------------------------------------------------------------------------
print("Step 1: Loading Local Datasets...")
try:
    # Using the specific filenames provided in the environment
    features = pd.read_csv('Features data set.xlsx - Features data set.csv')
    sales = pd.read_csv('sales data-set.xlsx - sales data-set.csv')
    stores = pd.read_csv('stores data-set.xlsx - stores data-set.csv')
    print("Success: All files loaded.")
except Exception as e:
    print(f"Error loading files: {e}")

# ------------------------------------------------------------------------------
# 2. DATA CLEANING & MERGING
# ------------------------------------------------------------------------------
# Standardize Column Names
for dataframe in [features, sales, stores]:
    dataframe.columns = dataframe.columns.str.strip().str.replace(' ', '_').str.title()
    dataframe.rename(columns={'Isholiday': 'IsHoliday', 'Cpi': 'CPI'}, inplace=True)

# Merging
df = pd.merge(sales, features, on=['Store', 'Date'], how='left')
if 'IsHoliday_x' in df.columns:
    df['IsHoliday'] = df['IsHoliday_x']
    df.drop(['IsHoliday_x', 'IsHoliday_y'], axis=1, inplace=True)
df = pd.merge(df, stores, on='Store', how='left')

# Preprocessing
df['Date'] = pd.to_datetime(df['Date'])
md_cols = ['Markdown1', 'Markdown2', 'Markdown3', 'Markdown4', 'Markdown5']
for col in md_cols:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0)

df['CPI'] = df['CPI'].fillna(df['CPI'].median())
df['Unemployment'] = df['Unemployment'].fillna(df['Unemployment'].median())

# ------------------------------------------------------------------------------
# 3. COMPONENT 1: ANOMALY DETECTION
# ------------------------------------------------------------------------------
print("Step 2: Detecting Sales Anomalies...")
iso = IsolationForest(contamination=0.01, random_state=42)
df['Anomaly'] = iso.fit_predict(df[['Weekly_Sales']].fillna(0))
df_clean = df[df['Anomaly'] == 1].reset_index(drop=True)

# ------------------------------------------------------------------------------
# 4. COMPONENT 2: STORE SEGMENTATION (CLUSTERING)
# ------------------------------------------------------------------------------
print("Step 3: Segmenting Stores into Behavioral Clusters...")
store_stats = df_clean.groupby('Store').agg({
    'Weekly_Sales': 'mean',
    'Size': 'first',
    'Temperature': 'mean'
}).reset_index()

scaler = StandardScaler()
scaled = scaler.fit_transform(store_stats.drop('Store', axis=1))
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
store_stats['Cluster'] = kmeans.fit_predict(scaled)

# ------------------------------------------------------------------------------
# 5. UBM VISUALIZATION SUITE (15 Charts)
# ------------------------------------------------------------------------------
def run_visualizations(df_plot, store_stats):
    print("Step 4: Generating Visual Insights...")
    
    # --- Univariate ---
    fig, axes = plt.subplots(1, 3, figsize=(18, 5))
    sns.histplot(df_plot['Weekly_Sales'], kde=True, ax=axes[0], color='blue').set_title('Distribution of Weekly Sales')
    sns.countplot(data=df_plot, x='Type', ax=axes[1]).set_title('Store Type Frequency')
    sns.boxplot(x=df_plot['Size'], ax=axes[2], color='green').set_title('Spread of Store Sizes')
    plt.tight_layout()
    plt.show()

    # --- Bivariate ---
    fig, axes = plt.subplots(1, 3, figsize=(18, 5))
    sns.lineplot(data=df_plot, x='Date', y='Weekly_Sales', ax=axes[0]).set_title('Sales Trend Over Time')
    sns.barplot(data=df_plot, x='Type', y='Weekly_Sales', ax=axes[1]).set_title('Avg Sales by Store Type')
    sns.scatterplot(data=df_plot, x='Temperature', y='Weekly_Sales', alpha=0.3, ax=axes[2]).set_title('Temp vs Sales')
    plt.tight_layout()
    plt.show()

    # --- Multivariate (Clustering & Correlations) ---
    plt.figure(figsize=(10, 6))
    sns.scatterplot(data=store_stats, x='Size', y='Weekly_Sales', hue='Cluster', palette='viridis', s=100)
    plt.title('Store Segmentation: Size vs Avg Sales (Clustered)')
    plt.show()

    plt.figure(figsize=(12, 8))
    sns.heatmap(df_plot[['Weekly_Sales', 'Size', 'Temperature', 'Fuel_Price', 'CPI', 'Unemployment']].corr(), annot=True, cmap='coolwarm')
    plt.title('Economic Feature Correlation Matrix')
    plt.show()

run_visualizations(df_clean, store_stats)

# ------------------------------------------------------------------------------
# 6. COMPONENT 3: DEMAND FORECASTING
# ------------------------------------------------------------------------------
print("Step 5: Training Demand Forecasting Model...")
df_final = pd.merge(df_clean, store_stats[['Store', 'Cluster']], on='Store', how='left')
df_final = pd.get_dummies(df_final, columns=['Type']) if 'Type' in df_final.columns else df_final
df_final['Week'] = df_final['Date'].dt.isocalendar().week.astype(int)
df_final['Year'] = df_final['Date'].dt.year

features_list = ['Store', 'Dept', 'CPI', 'Unemployment', 'Fuel_Price', 'Size', 'Cluster', 'Week', 'Year']
features_list += [c for c in df_final.columns if 'Type_' in c]

X = df_final[features_list].fillna(0)
y = df_final['Weekly_Sales']

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, shuffle=False)

# Using RandomForest for broad compatibility (can be swapped for XGBRegressor)
model = RandomForestRegressor(n_estimators=50, max_depth=10, random_state=42, n_jobs=-1)
model.fit(X_train, y_train)

# ------------------------------------------------------------------------------
# 7. FINAL EVALUATION & EXPORT
# ------------------------------------------------------------------------------
preds = model.predict(X_test)
rmse = np.sqrt(mean_squared_error(y_test, preds))
silhouette = silhouette_score(scaled, store_stats['Cluster'])

print("\n" + "="*50)
print("INTEGRATED RETAIL ANALYSIS COMPLETE")
print("="*50)
print(f"1. Clustering Quality (Silhouette): {silhouette:.4f}")
print(f"2. Forecasting Error (RMSE):        ${rmse:.2f}")
print(f"3. Anomalies Removed:               {len(df) - len(df_clean)} incidents")
print("="*50)

# Save results
output = X_test.copy()
output['Actual_Sales'] = y_test
output['Predicted_Sales'] = preds
output.to_csv('Retail_Forecast_Results.csv', index=False)
print("SUCCESS: Final predictions saved to 'Retail_Forecast_Results.csv'")
